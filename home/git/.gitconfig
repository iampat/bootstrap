[user]
	name = YOUR NAME
	email = you@example.com
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
# Per-machine overrides (e.g. work email). Not in the repo.
[include]
	path = ~/.gitconfig.local

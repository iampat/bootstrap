[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
# Identity and per-machine overrides live here, written by bootstrap_mac.sh. Not in the repo.
[include]
	path = ~/.gitconfig.local
